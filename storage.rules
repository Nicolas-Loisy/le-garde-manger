rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowedEmail() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/allowed_emails/$(request.auth.token.email));
    }

    match /recipes/{recipeId}/{fileName} {
      allow read: if isAllowedEmail();
      allow write: if isAllowedEmail()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
