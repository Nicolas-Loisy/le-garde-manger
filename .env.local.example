# Copiez ce fichier en .env.local et renseignez les valeurs de votre projet Firebase.
# .env.local n'est jamais commité (voir .gitignore).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL publique du site, utilisée comme secours pour le lien de connexion.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clé API Anthropic (https://console.anthropic.com/settings/keys), utilisée
# uniquement côté serveur (route /api/parse-recipe) pour le remplissage
# automatique de recette. Jamais exposée au client (pas de préfixe
# NEXT_PUBLIC_). Voir README, section "Remplissage automatique par IA".
ANTHROPIC_API_KEY=
