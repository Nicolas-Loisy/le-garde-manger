rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowedEmail() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/allowed_emails/$(request.auth.token.email.lower()));
    }

    // Liste blanche : gérée uniquement depuis la console Firebase / un script admin
    // (écriture toujours interdite côté client). Un utilisateur connecté peut lire
    // uniquement son propre document, pour que l'app sache si son email est autorisé
    // — sans pouvoir énumérer ni lire les emails des autres. Les IDs de document sont
    // toujours en minuscules (voir src/lib/auth.ts et scripts/manage-whitelist.mjs),
    // donc on compare le token en minuscules pour ignorer la casse de connexion.
    match /allowed_emails/{email} {
      allow read: if isSignedIn() && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // Recettes : lecture réservée aux emails autorisés, écriture idem
    // (pas de distinction contributeur/lecteur au lancement, cf. cahier des charges §7).
    match /recipes/{recipeId} {
      allow read: if isAllowedEmail();
      allow create, update, delete: if isAllowedEmail();
    }

    // Auteurs : lecture réservée aux emails autorisés, écriture idem.
    match /authors/{authorId} {
      allow read: if isAllowedEmail();
      allow write: if isAllowedEmail();
    }
  }
}
